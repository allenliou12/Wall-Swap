#!/bin/sh
# Commit message rules for every writer, Codex included (AGENTS.md "Commit messages a PM can read").
# Merge, revert and fixup commits keep git's own wording.
msg=$(grep -v '^#' "$1")
subject=$(printf '%s\n' "$msg" | sed -n '/./{p;q;}')
case "$subject" in
  'Merge '*|'Revert '*|'fixup! '*|'squash! '*) exit 0 ;;
esac
status=0
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|test|chore): [^ ]'; then
  echo "commit-msg: subject must start with feat:, fix:, docs:, test: or chore: then plain words."; status=1
fi
if printf '%s\n' "$msg" | grep -Eiq '^co-authored-by:|generated with \[?claude'; then
  echo "commit-msg: remove the attribution line."; status=1
fi
exit $status
